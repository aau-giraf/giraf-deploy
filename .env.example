# giraf-deploy — Environment Variables
# Copy to .env (or run ./setup.sh, which does it for you).
#
# This file configures docker-compose itself. The services read their own
# configuration from their own repos:
#
#   giraf-core/.env    DJANGO_SECRET_KEY, JWT_SECRET, POSTGRES_*, DJANGO_SETTINGS_MODULE
#   giraf-ai/.env      JWT_SECRET, IMAGE_PROVIDER, TTS_PROVIDER, provider API keys
#   weekplanner/.env   JWT_SECRET, ASPNETCORE_ENVIRONMENT
#
# Setting JWT_SECRET or a provider key here has no effect — put it in the
# service's own .env.

# PostgreSQL password for both database containers. Compose passes it on to
# core-api and weekplanner-api, so it does not need repeating anywhere else.
# Changing it after the first run requires `docker compose down -v`.
GIRAF_DB_PASSWORD=localdev123
